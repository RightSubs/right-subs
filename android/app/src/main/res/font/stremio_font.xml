<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans (SIL OFL), the font used by Stremio's web app. plus_jakarta_sans.ttf is
     a variable font (wght 200-800): one file, three weights through the variation axis
     (needs API 26, our minSdk). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/plus_jakarta_sans"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/plus_jakarta_sans"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/plus_jakarta_sans"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
</font-family>
