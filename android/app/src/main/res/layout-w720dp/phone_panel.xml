<?xml version="1.0" encoding="utf-8"?>
<!-- Wide screens (TV): QR on the left, instructions on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/phone_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <!-- Dark modules on white with a quiet zone, as cameras expect. -->
    <ImageView
        android:id="@+id/phone_qr"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@color/qr_light"
        android:contentDescription="@string/phone_qr_description"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_intro"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/phone_url"
            style="@style/Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/phone_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/phone_note"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/phone_cancel"
            style="@style/Action"
            android:layout_marginTop="16dp"
            android:text="@string/phone_cancel" />
    </LinearLayout>
</LinearLayout>
