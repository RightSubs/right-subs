<?xml version="1.0" encoding="utf-8"?>
<!-- Phone in portrait: one list per line, at full width. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/translation_first"
        android:textColor="@color/muted" />

    <Spinner
        android:id="@+id/translation_first"
        style="@style/Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dialog" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/translation_second"
        android:textColor="@color/muted" />

    <Spinner
        android:id="@+id/translation_second"
        style="@style/Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dialog" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/translation_third"
        android:textColor="@color/muted" />

    <Spinner
        android:id="@+id/translation_third"
        style="@style/Dropdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dialog" />
</merge>
