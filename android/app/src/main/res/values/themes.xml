<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette taken from Stremio's web app (stremio-web, src/App/styles.less). -->
    <color name="background">#FF0C0B11</color>
    <color name="surface">#FF1A173E</color>
    <color name="modal">#FF0F0D20</color>
    <color name="text">#E6FFFFFF</color>
    <color name="muted">#99FFFFFF</color>
    <color name="accent">#FF7B5BF5</color>
    <color name="accent_glow">#5E7B5BF5</color>
    <color name="success">#FF22B365</color>
    <color name="warning">#FFFFA500</color>
    <!-- Lighter than Stremio's danger (#DC2626): that one is under 4.5:1 on the background. -->
    <color name="error">#FFF87171</color>
    <color name="overlay">#0DFFFFFF</color>
    <color name="overlay_strong">#1AFFFFFF</color>
    <color name="accent_pressed">#FF6A4BE0</color>
    <color name="accent_focused">#FF9580F7</color>
    <color name="accent_disabled">#667B5BF5</color>
    <color name="overlay_pressed">#26FFFFFF</color>
    <color name="focus_ring">#FFFFFFFF</color>
    <!-- Background of art/icon-source.png (scripts/make-icons.sh BG). -->
    <color name="icon_background">#FF0F0620</color>
    <color name="qr_light">#FFFFFFFF</color>
    <color name="qr_dark">#FF000000</color>

    <style name="Theme.RightSubs" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:fontFamily">@font/stremio_font</item>
        <item name="android:alertDialogTheme">@style/Theme.RightSubs.Dialog</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <style name="Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Theme.RightSubs.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">@font/stremio_font</item>
    </style>

    <style name="Action" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:minWidth">160dp</item>
        <item name="android:fontFamily">@font/stremio_font</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Phone in portrait: half of a row (2×2 grid) and a full-width button. -->
    <style name="ActionCell" parent="Action">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="ActionBlock" parent="Action">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- Primary variants: same sizes, purple background. -->
    <style name="ActionPrimary" parent="Action">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="ActionCellPrimary" parent="ActionCell">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="ActionBlockPrimary" parent="ActionBlock">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="Field" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:fontFamily">@font/stremio_font</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHighlight">@color/accent_disabled</item>
    </style>

    <style name="Dropdown" parent="@android:style/Widget.DeviceDefault.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="Check" parent="@android:style/Widget.DeviceDefault.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/check_tint</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/bg_focus_row</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
