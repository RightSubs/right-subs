# Segredos do RightSubs. Copie para .env e preencha:  cp .env.example .env
# O .env nunca vai para o git.

# OpenSubtitles — conta gratuita em https://www.opensubtitles.com
# API key: perfil > API consumers > New consumer
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASSWORD=

# Somente no modo proxy (streams.indexers no config.yaml: Torrentio/Sootio passam pelo RightSubs).
# No modo complemento (Torrentio/Sootio instalados direto no Stremio + RD_TOKEN), deixe vazios.
# Indexadores já configurados com o Real-Debrid. Contêm a chave do RD: nunca compartilhe.
# Torrentio: configure em https://torrentio.strem.fun/configure e copie a URL do manifest.
TORRENTIO_URL=
# Sootio: copie a URL do manifest da sua instalação (termina em /manifest.json).
SOOTIO_URL=

# Real-Debrid (opcional, modo complemento): token em https://real-debrid.com/apitoken. Nunca compartilhe.
RD_TOKEN=

# DeepL (opcional): traduz para o idioma principal a legenda de referência em inglês,
# só em último caso, quando não há legenda no idioma principal nem no secundário.
# Chave em https://www.deepl.com/your-account/keys (plano DeepL API Free: 500 mil caracteres
# por mês, uns 7 a 10 filmes). Chaves do plano Free terminam em ":fx". Nunca compartilhe.
DEEPL_API_KEY=
