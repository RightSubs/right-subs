# RightSubs secrets. Copy to .env and fill in:  cp .env.example .env
# .env never goes into git.

# OpenSubtitles — free account at https://www.opensubtitles.com
# API key: profile > API consumers > New consumer
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER=
OPENSUBTITLES_PASSWORD=

# Proxy mode only (streams.indexers in config.yaml: Torrentio/Sootio go through RightSubs).
# In companion mode (Torrentio/Sootio installed directly in Stremio + RD_TOKEN), leave them empty.
# Indexers already set up with Real-Debrid. They carry the RD key: never share them.
# Torrentio: configure at https://torrentio.strem.fun/configure and copy the manifest URL.
TORRENTIO_URL=
# Sootio: copy the manifest URL of your instance (ends in /manifest.json).
SOOTIO_URL=

# Real-Debrid (optional, companion mode): token at https://real-debrid.com/apitoken. Never share it.
RD_TOKEN=

# DeepL (optional): translates a reference subtitle into the primary language, only as a last
# resort, when there is no subtitle in the primary or the secondary language.
# Key at https://www.deepl.com/your-account/keys (DeepL API Free plan: 500,000 characters
# a month, about 7 to 10 movies). Free plan keys end in ":fx". Never share it.
DEEPL_API_KEY=
